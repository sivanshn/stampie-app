{
  "expo": {
    "name": "Stampie",
    "slug": "stampie-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "de.stampie.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Zum Scannen der Kunden-QR-Codes wird die Kamera benötigt.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "de.stampie.app",
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Zum Scannen der Kunden-QR-Codes wird die Kamera benötigt."
        }
      ],
      "expo-asset",
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "e77d158c-4b5e-4bd0-9b1b-4b9013972171"
      }
    },
    "owner": "mou123zuv"
  }
}
